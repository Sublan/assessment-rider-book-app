APP_NAME=RideBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ridebook
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Ride domain (see config/ride.php). All fare values are integer PAISA.
# ---------------------------------------------------------------------------
RIDE_DEFAULT_CITY=Lahore

FARE_ECONOMY_BASE_MINOR=16000
FARE_ECONOMY_PER_KM_MINOR=6500
FARE_ECONOMY_PER_MIN_MINOR=1200
FARE_ECONOMY_MINIMUM_MINOR=26000
SURGE_ECONOMY=1.0

FARE_COMFORT_BASE_MINOR=26000
FARE_COMFORT_PER_KM_MINOR=9800
FARE_COMFORT_PER_MIN_MINOR=1800
FARE_COMFORT_MINIMUM_MINOR=42000
SURGE_COMFORT=1.15

RIDE_AVG_SPEED_KMH=22
RIDE_APPROACH_SPEED_KMH=18
RIDE_DISPATCH_OVERHEAD_MINUTES=3
RIDE_MAX_CANDIDATES=5
RIDE_MIN_TRIP_METERS=250
RIDE_MAX_TRIP_METERS=120000
RIDE_IDEMPOTENCY_TTL_HOURS=24

